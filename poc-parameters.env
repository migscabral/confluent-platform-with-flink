# Source this file before running the MOP. Replace REPLACE_ME values.
# Do not commit this file with real passwords or private keys.
# Public Confluent images are pulled anonymously from docker.io/confluentinc; no image-pull Secret is used.
export OCP_API_URL=https://api.example.com:6443
export OCP_USERNAME=ocp-admin
export OCP_PASSWORD=REPLACE_ME
export REGISTRY=docker.io

# Existing externally generated PKCS12/JKS files; no certificate generation is performed by this bundle.
export OCP_ROUTE_DOMAIN=apps.example.com
export CP_VERSION=8.3.1
# CFK product/operator version and Helm chart version are different values.
export CFK_VERSION=3.3.0
export INIT_VERSION=3.3.0
export CFK_CHART_VERSION=0.1718.10
export CMF_CHART_VERSION=2.4.1
export FKO_CHART_VERSION=1.150.0
export FLINK_IMAGE=${REGISTRY}/confluentinc/cp-flink:2.2.0-cp2
export FLINK_VERSION=v2_2
export KAFKA_EXTERNAL_BOOTSTRAP=kafka.apps.example.com:443

export SOURCE_CLIENT_PROPERTIES=/secure/path/source-client.properties
export SOURCE_KEYSTORE_FILE=/secure/path/source-client-keystore.jks
export SOURCE_TRUSTSTORE_FILE=/secure/path/source-client-truststore.jks

# Replace with your S3 bucket name, region, and credentials.
export S3_SOURCE_TOPIC=source_topic
export S3_BUCKET=replace-me
export S3_REGION=ap-southeast-1
export S3_PREFIX=poc/
export S3_ACCESS_KEY=REPLACE_ME
export S3_SECRET_KEY=REPLACE_ME
export S3_PLUGIN_VERSION=12.1.10 

# Replace with your MySQL database connection details and credentials.
export MYSQL_SOURCE_TOPIC=source_topic
export MYSQL_HOST=mysql.example.com
export MYSQL_PORT=3306
export MYSQL_DATABASE=poc
export MYSQL_TABLE=target_table
export MYSQL_USERNAME=REPLACE_ME
export MYSQL_PASSWORD=REPLACE_ME
export JDBC_PLUGIN_VERSION=10.9.6


# Replace with your MongoDB connection details and credentials.
export MONGODB_SOURCE_TOPIC=source_topic
export MONGODB_DATABASE=poc
export MONGODB_COLLECTION=target_collection
export MONGODB_URI=mongodb://REPLACE_ME
export MONGODB_PLUGIN_VERSION=3.0.1

# Existing externally generated PKCS12/JKS files; no certificate generation is performed by this bundle. The loader copies them unchanged into OCP Secrets.
# Copy the TLS artifacts into the execution workstation and update the paths below. 
# The passwords for the keystore and truststore files are stored in separate text files, which are also copied into OCP Secrets. The password files should contain only the password string, with no extra whitespace or newlines.

export KRAFT_TLS_SECRET=kraftcontroller-tls
export KRAFT_TLS_KEYSTORE_FILE=/secure/path/kraftcontroller-keystore.jks
export KRAFT_TLS_TRUSTSTORE_FILE=/secure/path/kraftcontroller-truststore.jks
export KRAFT_TLS_PASSWORD_FILE=/secure/path/kraftcontroller-jksPassword.txt
export KAFKA_TLS_SECRET=kafka-tls
export KAFKA_TLS_KEYSTORE_FILE=/secure/path/kafka-keystore.jks
export KAFKA_TLS_TRUSTSTORE_FILE=/secure/path/kafka-truststore.jks
export KAFKA_TLS_PASSWORD_FILE=/secure/path/kafka-jksPassword.txt
export CONNECT_TLS_SECRET=connect-tls
export CONNECT_TLS_KEYSTORE_FILE=/secure/path/connect-keystore.jks
export CONNECT_TLS_TRUSTSTORE_FILE=/secure/path/connect-truststore.jks
export CONNECT_TLS_PASSWORD_FILE=/secure/path/connect-jksPassword.txt
export SCHEMA_REGISTRY_TLS_SECRET=schemaregistry-tls
export SCHEMA_REGISTRY_TLS_KEYSTORE_FILE=/secure/path/schemaregistry-keystore.jks
export SCHEMA_REGISTRY_TLS_TRUSTSTORE_FILE=/secure/path/schemaregistry-truststore.jks
export SCHEMA_REGISTRY_TLS_PASSWORD_FILE=/secure/path/schemaregistry-jksPassword.txt
export CONTROL_CENTER_TLS_SECRET=controlcenter-tls
export CONTROL_CENTER_TLS_KEYSTORE_FILE=/secure/path/controlcenter-keystore.jks
export CONTROL_CENTER_TLS_TRUSTSTORE_FILE=/secure/path/controlcenter-truststore.jks
export CONTROL_CENTER_TLS_PASSWORD_FILE=/secure/path/controlcenter-jksPassword.txt
